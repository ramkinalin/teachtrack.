<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31) and above replaced fullBackupContent with two separate
  rule sets, because the two cases are genuinely different:

    cloud-backup    — uploaded to the user's Google account, restored on reinstall
                      or on a new phone. This is the "I lost my phone" case.
    device-transfer — copied directly phone-to-phone during setup. No cloud
                      involved, so nothing to be squeamish about including.

  Both include the app's files directory, which is where Hive keeps every box.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
